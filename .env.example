# ═══════════════════════════════════════════════════════════════════════════════
# 1. CORE & COMMON SETTINGS (REQUIRED FOR ALL MODES)
# ═══════════════════════════════════════════════════════════════════════════════

# Deployment platforms: telegram (default), discord, or telegram,discord (both).
ENABLED_PLATFORMS=telegram,discord

# Immich server base URL (must end in /api).
# Examples:
#   http://immich-server:2283/api          (when on the same docker network)
#   https://photos.example.com/api         (when accessed via a reverse proxy)
IMMICH_URL=http://immich-server:2283/api

# Immich API key — generate in Immich: Account Settings → API Keys
IMMICH_API_KEY=


# ═══════════════════════════════════════════════════════════════════════════════
# 2. TELEGRAM SETTINGS (REQUIRED WHEN TELEGRAM IS ENABLED)
# ═══════════════════════════════════════════════════════════════════════════════

# Telegram bot HTTP API token from @BotFather
TELEGRAM_BOT_TOKEN=

# api_id and api_hash from https://my.telegram.org/apps
# (Required by the bundled local Telegram Bot API server to raise file size limit to 2 GB)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Comma-separated whitelist of allowed Telegram numeric user IDs.
# Find your ID by messaging @userinfobot (e.g. 11111111,22222222)
TELEGRAM_ALLOWED_USER_IDS=

# Default album for Telegram imports. Created automatically if missing.
# Leave empty to upload directly to the main library without adding to an album.
TELEGRAM_ALBUM_NAME=Telegram Inbox

# Dynamic album template (e.g. {source} or {source}_{date:%Y-%m}).
# If empty or evaluation fails, falls back to TELEGRAM_ALBUM_NAME.
TELEGRAM_ALBUM_NAME_TEMPLATE=

# Dynamic naming template for photos, videos, animations, audio, and voice notes.
# Default: {source}_{message_id}_{index}
# Available variables: {source}, {source_id}, {source_username}, {username},
# {message_id}, {msg_id}, {sender}, {sender_id}, {chat_title}, {chat_id},
# {date:%Y%m%d_%H%M%S}, {msg_date}, {forward_date}, {exif_date}, {index},
# {media_type}, {file_unique_id}, {media_group_id}, {caption}, {original_name},
# {forward_source}, {forward_channel}, {forward_author}, {forward_source_id}, {forward_msg_id}
TELEGRAM_MEDIA_NAME_TEMPLATE={source}_{message_id}_{index}

# Dynamic naming template for document files.
# Default: {original_name}
TELEGRAM_DOCUMENT_NAME_TEMPLATE={original_name}


# ═══════════════════════════════════════════════════════════════════════════════
# 3. DISCORD SETTINGS (REQUIRED WHEN DISCORD IS ENABLED)
# ═══════════════════════════════════════════════════════════════════════════════

# Discord bot token from the Discord Developer Portal
DISCORD_TOKEN=

# Comma-separated whitelist of allowed Discord numeric user IDs.
# Enable Developer Mode in Discord settings, right-click your profile to copy user ID.
DISCORD_ALLOWED_USER_IDS=

# Default album for Discord imports. Created automatically if missing.
# Leave empty to upload directly to the main library without adding to an album.
DISCORD_ALBUM_NAME=Discord Inbox

# Dynamic album template (e.g. {source} or {source}_{date:%Y-%m}).
# If empty or evaluation fails, falls back to DISCORD_ALBUM_NAME.
DISCORD_ALBUM_NAME_TEMPLATE=

# Dynamic naming template for Discord attachments.
# Default in code is {original_name}. Recommended template:
DISCORD_FILENAME_TEMPLATE={source}_{sender}_{message_id}_{index}

# Per-attachment input size limit in MiB (default: 2000)
DISCORD_MAX_ATTACHMENT_MB=2000


# ═══════════════════════════════════════════════════════════════════════════════
# 4. GENERAL & ADVANCED SETTINGS
# ═══════════════════════════════════════════════════════════════════════════════

# Timezone for date formatting in filenames and albums (default: UTC)
# Examples: Asia/Shanghai, America/New_York, Europe/London
TZ=UTC

# Default fallback language for bot replies when user language is unavailable or unsupported.
# Supported: en (English), zh (Chinese), ja (Japanese), ru (Russian). Default: en
DEFAULT_LANGUAGE=en

# Archive processing limits (ZIP, RAR, 7z, tar)
# Maximum incoming archive size in MB (default: 2000)
MAX_ARCHIVE_MB=2000
# Maximum number of media entries allowed per archive before rejecting the archive (default: 1000)
MAX_ARCHIVE_FILES=1000

# Automatically delete local downloaded temporary files after ingestion or deduplication
CLEANUP_LOCAL_FILES=true

# Logging level: DEBUG / INFO / WARNING / ERROR (default: INFO)
LOG_LEVEL=INFO

# Paths and URLs configured for the bundled Docker Compose environment
# (Keep defaults unless using custom network/volume setups)
# DATA_DIR=/data
# TELEGRAM_FILES_DIR=/var/lib/telegram-bot-api
# TELEGRAM_API_BASE=http://telegram-bot-api:8081
