# ─────────────── REQUIRED ───────────────

# Telegram bot token from @BotFather
BOT_TOKEN=

# api_id / api_hash from https://my.telegram.org/apps
# (needed by the bundled local Telegram Bot API server to raise the
#  file-size limit from 20 MB to 2 GB)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Your Immich server base URL ending in /api.
# Examples:
#   http://immich-server:2283/api          (same docker network)
#   https://photos.example.com/api         (reverse-proxied)
IMMICH_URL=http://immich-server:2283/api

# Immich API key — generate in Account Settings → API Keys
IMMICH_API_KEY=

# Comma-separated whitelist of Telegram user IDs allowed to use the bot.
# Find your own ID by messaging @userinfobot.
ALLOWED_USER_IDS=

# ─────────────── OPTIONAL ───────────────

# telegram (default), discord, or telegram,discord.
ENABLED_PLATFORMS=telegram
# Discord bot token and comma-separated Discord user ID whitelist.
DISCORD_TOKEN=
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALBUM_NAME=Discord Inbox
# Templates use the same variables and timezone as Telegram.
DISCORD_FILENAME_TEMPLATE={original_name}
DISCORD_ALBUM_NAME_TEMPLATE=
# Per-attachment input limit in MiB.
DISCORD_MAX_ATTACHMENT_MB=2000

# If set, every uploaded asset is added to this album (created if missing).
# Leave empty to upload to the main library only.
ALBUM_NAME=Telegram Inbox

# Timezone for date formatting in filenames and albums (default: UTC)
# Example: Asia/Shanghai, America/New_York, Europe/London
TZ=UTC

# Default fallback language for bot replies when user language is unavailable or unsupported.
# Supported: en (English), zh (Chinese), ja (Japanese), ru (Russian). Default: en
DEFAULT_LANGUAGE=en

# Dynamic naming template for photos, videos, animations, audio, and voice notes.
# Default: {source}_{message_id}_{index}
# Supports variables: {source}, {source_id}, {source_username}, {message_id},
# {date:%Y%m%d_%H%M%S}, {msg_date}, {forward_date}, {exif_date}, {sender},
# {media_type}, {file_unique_id}, {media_group_id}, {caption}, {index}
MEDIA_NAME_TEMPLATE={source}_{message_id}_{index}

# Dynamic naming template for document payloads.
# Default: {original_name}
DOCUMENT_NAME_TEMPLATE={original_name}

# Dynamic album template. If empty or resolves to empty, falls back to ALBUM_NAME.
# Example: {source} or {date:%Y-%m}
ALBUM_NAME_TEMPLATE=

# Hard limits for archive processing (zip/rar/7z/tar)
MAX_ARCHIVE_MB=2000
MAX_ARCHIVE_FILES=1000

# Automatically delete local downloaded files after successful ingestion or duplicate detection
CLEANUP_LOCAL_FILES=true

# Logging
LOG_LEVEL=INFO
